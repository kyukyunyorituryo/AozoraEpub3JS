<?xml version="1.0" encoding="UTF-8"?>
<ncx xmlns="http://www.daisy.org/z3986/2005/ncx/" version="2005-1">
<head>
    <meta name="dtb:uid" content="urn:uuid:<%= identifier -%>"/>
    <meta name="dtb:depth" content="<%= ncx_depth -%>"/>
    <meta name="dtb:totalPageCount" content="0"/>
    <meta name="dtb:maxPageNumber" content="0"/>
</head>
<docTitle>
    <text><%= title -%></text>
</docTitle>
<navMap>
<% let idx = 0;
let hasItem = false;
-%>
<% if (bookInfo.insertCoverPage && bookInfo.insertCoverPageToc) { -%>
    <% idx++; hasItem = true; -%>
    <navPoint id="toccover" playOrder="<%= idx %>">
        <navLabel>
            <text><%= cover_name %></text>
        </navLabel>
        <content src="xhtml/cover.xhtml"/>
    </navPoint>
<% } -%>
<% if (chapters && chapters.length > 0) { -%>
<% for (let i = 0; i < chapters.length; i++) { -%>
<% const ch = chapters[i]; -%>
<% if (ch.chapterName) { -%>
    <% idx++; hasItem = true; -%>
        <navPoint id="toc<%= idx -%>" playOrder="<%= idx -%>">
        <navLabel>
            <text><%= ch.noTagChapterName %></text>
        </navLabel>
        <% if (ch.chapterId) { -%>
            <content src="xhtml/<%= ch.sectionId %>.xhtml#<%= ch.chapterId %>"/>
        <% } else { -%>
            <content src="xhtml/<%= ch.sectionId %>.xhtml"/>
        <% } -%>
    </navPoint>
<% } -%>
<% } -%>
<% } -%>
<% if (!hasItem) { -%>
    <% if (sections && sections.length > 0) { -%>
        <% idx++; -%>
        <navPoint id="toc<%= idx %>" playOrder="<%= idx %>">
            <navLabel>
                <text>本文</text>
            </navLabel>
            <content src="xhtml/<%= sections[0].sectionId %>.xhtml"/>
        </navPoint>
    <% } else { -%>
        <% idx++; -%>
        <navPoint id="toc<%= idx %>" playOrder="<%= idx %>">
            <navLabel>
                <text>目次</text>
            </navLabel>
            <content src="nav.xhtml"/>
        </navPoint>
    <% } -%>
<% }; -%>
</navMap>
</ncx>
